{
  "ai": {
    "provider": "openai",
    "provider_chain": null,
    "model": "deepseek-ai/DeepSeek-V4.1-Flash",
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key_env": "OPENAI_API_KEY",
    "chatgpt_account": null,
    "extra_body": null,
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 3.0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["zh"],
    "azure_endpoint_env": null,
    "api_version": null
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100
    },
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "subreddit": "MachineLearning", "sort": "hot", "fetch_limit": 15, "min_score": 50 }
      ],
      "fetch_comments": 5
    },
    "rss": [
      { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ai-tools" },
      { "name": "OpenAI Blog", "url": "https://openai.com/blog/rss.xml", "enabled": true, "category": "ai-official" },
      { "name": "Hugging Face Blog", "url": "https://huggingface.co/blog/feed.xml", "enabled": true, "category": "ai-tools" },
      { "name": "Hacker News AI", "url": "https://hnrss.org/newest?q=AI", "enabled": true, "category": "ai-trends" },
      { "name": "Product Hunt", "url": "https://www.producthunt.com/feed", "enabled": true, "category": "new-products" },
      { "name": "arXiv AI + Robotics + Applied Physics", "url": "https://rss.arxiv.org/rss/cs.AI+cs.RO+physics.app-ph", "enabled": true, "category": "physics-ai" },
      { "name": "arXiv Condensed Matter", "url": "https://rss.arxiv.org/rss/cond-mat", "enabled": true, "category": "physics-ai" },
      { "name": "Advanced Functional Materials", "url": "https://onlinelibrary.wiley.com/feed/15214095/most-recent", "enabled": true, "category": "thermoelectric" },
      { "name": "少数派", "url": "https://sspai.com/feed", "enabled": true, "category": "tech-blog" },
      { "name": "奇客Solidot", "url": "https://www.solidot.org/index.rss", "enabled": true, "category": "tech-blog" }
    ],
    "github": [
      { "type": "repo_releases", "owner": "openai", "repo": "whisper", "enabled": true },
      { "type": "repo_releases", "owner": "anthropics", "repo": "claude-code", "enabled": true }
    ]
  }
}
